# Local development. Copy to .env and edit. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/ifca
API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://127.0.0.1:8001
NODE_ENV=development
# Optional development seed; choose your own values before npm run seed.
SEED_EMAIL=
SEED_PASSWORD=
# Docker Compose only: choose a local database username and a long URL-safe password.
MONGO_USERNAME=
MONGO_PASSWORD=
